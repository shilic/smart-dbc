{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-v-in-tag": true,
  "changelog-sections": [
    { "type": "feat", "section": "新增功能", "hidden": false },
    { "type": "fix", "section": "问题修复", "hidden": false },
    { "type": "perf", "section": "性能优化", "hidden": false },
    { "type": "refactor", "section": "重构", "hidden": false },
    { "type": "revert", "section": "回滚", "hidden": false },
    { "type": "docs", "section": "文档", "hidden": false },
    { "type": "style", "section": "代码风格", "hidden": false },
    { "type": "test", "section": "测试", "hidden": false },
    { "type": "build", "section": "构建系统", "hidden": false },
    { "type": "ci", "section": "持续集成", "hidden": false },
    { "type": "chore", "section": "其他杂项", "hidden": false }
  ],
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "generic",
          "path": "build.gradle.kts"
        }
      ]
    }
  }
}
